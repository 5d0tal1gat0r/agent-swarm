{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "operator-turn",
  "type": "object",
  "required": ["id", "conversationTarget", "messageId", "status", "createdAt", "attempts"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "conversationTarget": { "type": "string", "minLength": 1, "maxLength": 160 },
    "messageId": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["queued", "running", "succeeded", "failed"] },
    "createdAt": { "$ref": "agent-context#/$defs/timestamp" },
    "startedAt": { "anyOf": [{ "type": "null" }, { "$ref": "agent-context#/$defs/timestamp" }] },
    "finishedAt": { "anyOf": [{ "type": "null" }, { "$ref": "agent-context#/$defs/timestamp" }] },
    "attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
    "error": { "type": ["string", "null"], "maxLength": 1000 }
  }
}
