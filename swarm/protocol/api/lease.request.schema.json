{
  "type": "object",
  "required": ["department", "slots", "manager"],
  "additionalProperties": false,
  "properties": {
    "department": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "slots": { "type": "integer", "minimum": 1, "maximum": 10 },
    "manager": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
