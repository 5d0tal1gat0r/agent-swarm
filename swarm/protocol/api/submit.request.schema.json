{
  "type": "object",
  "required": ["manager", "pr", "headSha", "evidence"],
  "additionalProperties": false,
  "properties": {
    "manager": { "type": "string", "minLength": 1, "maxLength": 100 },
    "pr": { "type": "integer", "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "met", "detail"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 500 },
          "met": { "type": "boolean" },
          "detail": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
