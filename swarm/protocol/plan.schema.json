{
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["key", "title", "paths", "acceptance", "size", "priority", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "paths": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "acceptance": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "size": { "enum": ["S", "M", "L"] },
          "priority": { "enum": ["p0", "p1", "p2", "p3"] },
          "dependsOn": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" } }
        }
      }
    }
  }
}
