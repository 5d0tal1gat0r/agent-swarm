{
  "type": "object",
  "required": ["version", "repo", "contracts", "departments"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
    "contracts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "departments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,58}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["paths", "host", "standby", "agent", "concurrency", "maxSubagents"],
        "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "host": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "standby": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9-]+$" },
          "agent": { "enum": ["claude", "codex", "gemini", "antigravity"] },
          "concurrency": { "type": "integer", "minimum": 1, "maximum": 10 },
          "maxSubagents": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      }
    }
  }
}
