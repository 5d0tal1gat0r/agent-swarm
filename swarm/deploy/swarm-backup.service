# Nightly orchestrator DB backup on that machine (VACUUM INTO, never overwrites).
# With SWARM_BACKUP_PUSH set in the env file, the new file is also copied to the server.
[Unit]
Description=Swarm orchestrator database backup

[Service]
Type=oneshot
WorkingDirectory=%h/swarm-app/repo/swarm
EnvironmentFile=-%h/.config/swarm/orchestrator.env
ExecStart=%h/swarm-app/repo/swarm/scripts/swarmctl backup --nightly
