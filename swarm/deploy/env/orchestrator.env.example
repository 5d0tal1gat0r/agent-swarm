# Copy to ~/.config/swarm/orchestrator.env and chmod 600 (swarmctl install orchestrator does both). No secrets are committed.
# The orchestrator runs on the orchestrator machine (any machine on the tailnet works).
# swarmctl install/import replaces SWARM_HOST with this machine's Tailscale address and adds PATH.
SWARM_HOST=127.0.0.1
SWARM_PORT=3423
SWARM_BUS_MCP_URL=http://<server-ip>:3422/mcp
# Optional: copy each nightly backup to the server (scp target, ssh key login).
# SWARM_BACKUP_PUSH=<owner>@<server>:backups/swarm/
# GitHub token for the orchestrator: fine-grained, scoped to the swarm's repository only.
# Add the line when issued. Never commit it, never put it in a flag or a container.
# GH_TOKEN=
