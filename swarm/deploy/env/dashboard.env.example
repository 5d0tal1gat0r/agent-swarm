# Listen address for the dashboard (server Tailscale IP or 127.0.0.1 for local use).
DASH_HOST=<server-ip>
DASH_PORT=3424
# bus: follow the orchestrator's published address, verified with /whoami (ARCHITECTURE 43).
SWARM_ORCH_URL=bus
SWARM_BUS_MCP_URL=http://<server-ip>:3422/mcp
# Dashboard-role token (orchestrator token add server-dashboard --member <login> --dashboard), saved mode 0600.
DASH_TOKEN_NAME=server-dashboard
DASH_TOKEN_FILE=~/.swarm/dashboard.token
DASH_POLL_SECONDS=15
# Watchdog state file on this machine, shown in the service line.
DASH_WATCHDOG_FILE=~/.swarm/watchdog.json
# Users for the password sign-in (name -> scrypt hash + member token), mode 0600.
DASH_USERS_FILE=~/.swarm/dashboard-users.json
# Last orchestrator snapshot, kept so a restarted dashboard still shows it while the orchestrator is offline (mode 0600).
DASH_SNAPSHOT_FILE=~/.swarm/dashboard-snapshot.json
# Signed-in sessions (hash of the session id, user, expiry; no tokens), so a restart signs nobody out (mode 0600).
DASH_SESSIONS_FILE=~/.swarm/dashboard-sessions.json

# Agent cockpit page, common live summary bridge and restart-safe summary cache.
SWARM_AGENT_COCKPIT=1
DASH_AGENT_CACHE_FILE=~/.swarm/dashboard-agents.json

# Chat history (channels.json, one .jsonl per channel, archive/ for deleted channels), dir mode 0700.
DASH_CHAT_DIR=~/.swarm/dashboard-chat
# Maintenance flag (ARCHITECTURE 77): swarmctl upgrade/restart and `swarmctl maintenance on|off` write it; pages show a banner.
DASH_MAINTENANCE_FILE=~/.swarm/dashboard-maintenance.json
