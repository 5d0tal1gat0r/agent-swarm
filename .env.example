# Example of the .env that scripts/bootstrap.sh writes on the server.
# Hosts are the server's Tailscale IPv4; never bind to a public interface.
AGENT_COMM_HOST=<server-ip>
AGENT_COMM_PORT=3421
AGENT_COMM_HOME=~/.agent-comm
AGENT_COMM_DB=~/.agent-comm/agent-comm.db
AGENT_COMM_INDEX_JS=~/agent-comm/source/dist/index.js
AGENT_COMM_MCP_HOST=<server-ip>
AGENT_COMM_MCP_PORT=3422
